# Distribution automation configuration.
# Copy to `.env` (git-ignored) and fill in. NONE are required to run:
# with all of these unset, distribution still works — it just writes local
# draft files instead of sending anything live. See docs/DISTRIBUTION.md.

# --- Newsletter (Buttondown) -------------------------------------------------
# API token from https://buttondown.email/settings/programming
# When set, `npm run distribute` creates a DRAFT email per new piece for a
# human to review and send. When unset, a local draft file is written instead.
BUTTONDOWN_API_KEY=

# Your Buttondown username, exposed to the site so the subscribe form can post
# to Buttondown's hosted endpoint (no backend needed). MUST start with PUBLIC_
# for Astro to include it in the built site.
PUBLIC_NEWSLETTER_USERNAME=

# --- Social cross-post -------------------------------------------------------
# Optional webhook to auto-queue social drafts (Buffer, Zapier, Make, Slack,
# Discord, n8n, …). When set, each new piece POSTs a JSON payload here. When
# unset, a local social draft file is written for a human to post manually.
SOCIAL_WEBHOOK_URL=

# --- Behaviour ---------------------------------------------------------------
# Set to 0 to skip the distribution step inside `npm run deploy`.
DISTRIBUTE=1
