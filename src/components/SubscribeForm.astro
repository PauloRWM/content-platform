---
// Newsletter subscribe form. Captures subscribers straight into our email
// provider (Buttondown) with NO backend — the form posts to the provider's
// hosted subscribe endpoint, which suits a static site.
//
// Setup: set PUBLIC_NEWSLETTER_USERNAME (your Buttondown username) in the build
// environment. Until it's set, the form renders in a friendly "not yet
// configured" state instead of posting to a broken URL. See docs/DISTRIBUTION.md.
//
// Drop <SubscribeForm /> into any page or layout to show it.
export interface Props {
  heading?: string;
  blurb?: string;
}
const {
  heading = 'Get new pieces by email',
  blurb = 'No spam. Unsubscribe anytime.',
} = Astro.props;

const username = import.meta.env.PUBLIC_NEWSLETTER_USERNAME;
const action = username
  ? `https://buttondown.email/api/emails/embed-subscribe/${username}`
  : null;
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <h2 id="subscribe-heading">{heading}</h2>
  {action ? (
    <form
      class="subscribe-form"
      action={action}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('https://buttondown.email/${username}', 'popupwindow')`}
    >
      <label class="sr-only" for="bd-email">Email address</label>
      <input
        id="bd-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <button type="submit">Subscribe</button>
    </form>
    <p class="subscribe-note">{blurb}</p>
  ) : (
    <p class="subscribe-note">
      Newsletter sign-up is not configured yet. An engineer needs to set
      <code>PUBLIC_NEWSLETTER_USERNAME</code>. See <code>docs/DISTRIBUTION.md</code>.
    </p>
  )}
</section>

<style>
  .subscribe {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
  }
  .subscribe h2 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }
  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .subscribe-form input {
    flex: 1 1 12rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.25);
    color: inherit;
    font-size: 1rem;
  }
  .subscribe-form button {
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    border: 0;
    background: #4f7cff;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .subscribe-form button:hover { background: #3d67e0; }
  .subscribe-note {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }
</style>
