---
// Layout for a single article. Renders the post body (passed in as <slot />)
// with a title, byline, and date, and adds article-specific SEO metadata.
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  draft?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'paulo testes',
  tags = [],
  draft = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — paulo testes`} description={description} ogType="article" noindex={draft}>
  <!-- Article metadata for social/search, injected into <head>. -->
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={author} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <main class="wrap">
    <p><a href={`${base}/blog`}>← All posts</a></p>

    {draft && (
      <p class="draft-banner">
        <strong>DRAFT — not live.</strong> This preview only appears when running the
        site locally. Set <code>draft: false</code> and merge to publish.
      </p>
    )}

    <article class="post">
      <header>
        <h1>{title}</h1>
        <p class="byline">
          By {author} · <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
          {updatedDate && <> · updated {fmt(updatedDate)}</>}
        </p>
        {tags.length > 0 && (
          <p class="tags">{tags.map((t) => <span class="tag">#{t}</span>)}</p>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>

    <footer class="meta">
      <a href={`${base}/blog`}>← Back to all posts</a>
    </footer>
  </main>
</BaseLayout>
