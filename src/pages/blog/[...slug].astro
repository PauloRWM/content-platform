---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

// One page per post. In production only PUBLISHED posts (draft === false) get a
// page — drafts 404, so they can never be reached on the live site. When
// running locally (`npm run dev`), drafts DO get pages so reviewers can preview
// them exactly as they'll look.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? data.draft === false : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout {...post.data}>
  <Content />
</PostLayout>
