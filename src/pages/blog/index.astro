---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Only published posts (draft === false) ever appear here.
const posts = (await getCollection('posts', ({ data }) => data.draft === false)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Count drafts so we can show a preview link — but only while running locally.
const draftCount = import.meta.env.PROD
  ? 0
  : (await getCollection('posts', ({ data }) => data.draft === true)).length;
---

<BaseLayout title="Blog — paulo testes" description="Writing from paulo testes.">
  <main class="wrap">
    <p><a href={base || '/'}>← Home</a></p>
    <h1>Blog</h1>

    {posts.length === 0 ? (
      <p class="lead">No posts published yet. The first one is on its way.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
            <p class="post-desc">{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </li>
        ))}
      </ul>
    )}

    {draftCount > 0 && (
      <p class="meta">
        You have {draftCount} draft{draftCount === 1 ? '' : 's'} in progress.
        <a href={`${base}/drafts`}>Preview drafts →</a>
        <br />(This line only shows in local preview, never on the live site.)
      </p>
    )}
  </main>
</BaseLayout>
